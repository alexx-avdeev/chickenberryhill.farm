---
import Logo from "./Logo.astro";
import InstagramIcon from "./InstagramIcon.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-line" data-site-footer>
  <div
    class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-6 px-[18px] py-12 md:px-8"
  >
    <Logo size="sm" />
    <p class="text-[14px] text-ink-softer">{site.location}</p>
    <a
      href={site.instagram}
      class="inline-flex items-center gap-2 text-[14px] font-semibold"
      rel="me noopener noreferrer"
      target="_blank"
    >
      <InstagramIcon size={18} />
      Instagram
    </a>
  </div>
  <div class="mx-auto max-w-page px-[18px] pb-10 md:px-8">
    <p class="text-[13px] text-ink-faint">
      © {year} {site.name}. Family raised in {site.region}.
    </p>
  </div>
</footer>
