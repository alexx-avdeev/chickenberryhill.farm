---
import { site } from "../data/site";

interface Props {
  /** Footer uses a slightly smaller mark than the nav. */
  size?: "sm" | "md";
}

const { size = "md" } = Astro.props;

const scale = {
  md: { mark: "size-[26px] text-[15px]", word: "text-[18px]" },
  sm: { mark: "size-6 text-[14px]", word: "text-[16px]" },
}[size];
---

<span class="flex items-center gap-[9px] text-ink">
  <span
    class:list={[
      "inline-flex flex-none items-center justify-center rounded-full bg-berry font-display font-medium text-ink-on-dark",
      scale.mark,
    ]}
    aria-hidden="true">C</span
  >
  <span class:list={["font-display tracking-[-0.01em]", scale.word]}
    >{site.name}</span
  >
</span>
