---
import Logo from "./Logo.astro";
import { navLinks } from "../data/site";

// Normalise so "/about" and "/about/" both match.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => (href.replace(/\/+$/, "") || "/") === path;

/**
 * The current page is marked with `aria-current="page"` and styled off that
 * attribute rather than a separate class, so there is one source of truth —
 * SwipeNavigation re-syncs it after a swipe and the styling follows for free.
 *
 * Desktop gets an underline; once the menu stacks on mobile an underline reads
 * as a divider, so it becomes a tint instead. The two live in disjoint media
 * queries (`md:` / `max-md:`) so neither has to out-specify the other.
 */
const linkClass = [
  "text-ink-softer transition-colors hover:text-ink",
  "aria-[current=page]:text-ink",
  "md:aria-[current=page]:border-b md:aria-[current=page]:border-nav-underline md:aria-[current=page]:py-[3px]",
  "max-md:rounded-[10px] max-md:px-2 max-md:py-[13px] max-md:text-[16px]",
  "max-md:aria-[current=page]:bg-nav-active-tint",
].join(" ");
---

<header
  class="sticky top-0 z-50 border-b border-line bg-bg/82 backdrop-blur-[20px] backdrop-saturate-[180%]"
  data-site-nav
>
  <nav
    class="relative mx-auto flex h-14 max-w-page items-center justify-between px-[18px] md:px-8"
    aria-label="Main"
  >
    <a href="/" class="text-ink">
      <Logo />
    </a>

    <button
      type="button"
      class="-m-2 hidden cursor-pointer items-center justify-center p-2 text-ink max-md:inline-flex"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav-links"
      data-nav-toggle
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
    </button>

    <div
      class="flex items-center gap-[34px] text-[14px] font-medium max-md:absolute max-md:inset-x-0 max-md:top-14 max-md:hidden max-md:flex-col max-md:items-stretch max-md:gap-1 max-md:border-b max-md:border-line max-md:bg-bg/98 max-md:px-[18px] max-md:pt-2.5 max-md:pb-5 max-md:backdrop-blur-[20px] max-md:backdrop-saturate-[180%] max-md:data-[open]:flex"
      id="nav-links"
      data-nav-links
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={linkClass}
            aria-current={isActive(link.href) ? "page" : undefined}
            data-nav-link
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/products/"
        class="rounded-full bg-dark px-4 py-2 text-ink-on-dark transition-colors hover:bg-dark-hover hover:text-ink-on-dark max-md:mt-1.5 max-md:rounded-[10px] max-md:px-2 max-md:py-[13px] max-md:text-center max-md:text-[16px]"
        >Shop</a
      >
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const links = document.querySelector<HTMLElement>("[data-nav-links]");

  if (toggle && links) {
    const setOpen = (open: boolean) => {
      links.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(!links.hasAttribute("data-open"));
    });

    // Navigating within the menu should close it, and so should Escape.
    links.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && links.hasAttribute("data-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Reset state if the viewport grows past the mobile breakpoint while open.
    window.matchMedia("(min-width: 721px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
