---
import fs from "node:fs";
import path from "node:path";
import { Picture } from "astro:assets";

/**
 * The Astro stand-in for the design's <image-slot>.
 *
 * Two ways to give it a photo:
 *
 *   `image`  an asset imported from `src/assets/`. Astro re-encodes it to AVIF
 *            and WebP at several widths and emits a <picture> with a srcset —
 *            use this for anything real, the originals are far too heavy to
 *            ship as-is.
 *   `src`    a path under `public/`, served untouched. For files that aren't
 *            worth processing, or aren't in the repo yet.
 *
 * With neither it renders a labelled well, so the layout still reads correctly
 * and it's obvious which picture is missing.
 */

interface Props {
  /** Imported asset — optimised and made responsive. Preferred. */
  image?: ImageMetadata | null;
  /** Path under public/, used as-is. */
  src?: string | null;
  alt?: string;
  /** Shown in the empty state — say what photo belongs here. */
  label: string;
  /**
   * CSS aspect-ratio for the frame, e.g. "4 / 3". Omit with `image` and the
   * frame takes the photo's own proportions, so nothing is ever cropped.
   * Ignored when `height` is set.
   */
  aspect?: string;
  /** Fixed height instead of an aspect ratio (used by the home hero). */
  height?: string;
  maxHeight?: string;
  radius?: string;
  /** First image on the page shouldn't be lazy-loaded. */
  eager?: boolean;
  /**
   * Overrides the priority `eager` would imply. Carousel slides past the first
   * are in the viewport, so `loading="lazy"` alone barely defers them — marking
   * them "low" keeps them from competing with the LCP image.
   */
  fetchPriority?: "high" | "low" | "auto";
  /** Widths the layout renders this at, for the browser to pick from. */
  sizes?: string;
  /**
   * Which part of the photo survives when the frame crops it — the CSS
   * `object-position`. "center" keeps the middle; "top" / "50% 30%" pull the
   * visible band upwards, which is what you want when faces sit high in frame.
   */
  objectPosition?: string;
}

const {
  image = null,
  src = null,
  alt = "",
  label,
  aspect,
  height,
  maxHeight,
  radius = "var(--radius-xl)",
  eager = false,
  sizes = "(max-width: 720px) calc(100vw - 36px), (max-width: 1184px) calc(100vw - 64px), 1056px",
  objectPosition = "center",
  fetchPriority = eager ? "high" : "auto",
} = Astro.props;

/**
 * Photos are added to public/ one at a time, so a `src` may point at a file
 * that isn't there yet. Check at build time and fall back to the placeholder
 * rather than shipping a broken image.
 */
function existsInPublic(publicPath: string): boolean {
  // Anything not root-relative (a remote URL) isn't ours to verify.
  if (!publicPath.startsWith("/")) return true;
  return fs.existsSync(path.join(process.cwd(), "public", publicPath));
}

const resolvedSrc = src && existsInPublic(src) ? src : null;

if (src && !resolvedSrc) {
  console.warn(
    `[Photo] public${src} not found — rendering the "${label}" placeholder instead.`,
  );
}

// `fallbackFormat` on <Picture> below matters: without it the <img> fallback
// inherits the master's format, so a PNG master ships multi-megabyte fallbacks
// to any browser that skips the AVIF/WebP sources.
//
// Never upscale past the source, and don't bother with widths above what the
// 1120px shell can show on a 2x screen.
const candidateWidths = [480, 768, 1056, 1600, 2112];
const widths = image
  ? candidateWidths.filter((w) => w <= image.width).concat(image.width)
  : [];

const naturalAspect = image ? `${image.width} / ${image.height}` : null;
const frameAspect = aspect ?? naturalAspect ?? "4 / 3";

const frameStyle = [
  height ? `height:${height}` : `aspect-ratio:${frameAspect}`,
  maxHeight ? `max-height:${maxHeight}` : null,
  `border-radius:${radius}`,
  `--photo-position:${objectPosition}`,
]
  .filter(Boolean)
  .join(";");
---

<div class="photo" style={frameStyle}>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        formats={["avif", "webp"]}
        fallbackFormat="jpeg"
        widths={[...new Set(widths)]}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        decoding={eager ? "sync" : "async"}
        fetchpriority={fetchPriority}
      />
    ) : resolvedSrc ? (
      <img
        src={resolvedSrc}
        alt={alt}
        loading={eager ? "eager" : "lazy"}
        decoding={eager ? "sync" : "async"}
        fetchpriority={fetchPriority}
      />
    ) : (
      <span class="photo__empty">{label}</span>
    )
  }
  <slot />
</div>

<style>
  .photo {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--surface-placeholder);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--photo-position, center);
  }

  .photo__empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-faint);
    border: 1px dashed var(--border-dashed);
    border-radius: inherit;
  }
</style>
