---
/**
 * Interactive swipe paging for touch devices.
 *
 * Dragging horizontally moves the current page with your finger while the
 * neighbouring page follows it in from the other side. Past a third of the
 * screen (or with enough flick) it commits, otherwise it springs back.
 *
 * Order comes from `navLinks`: Home → About → Products → Contact.
 *
 * To make the neighbour visible *during* the drag it has to already be in
 * hand, so both neighbours are fetched on idle and the swap is done in the
 * client rather than by navigating. If a neighbour hasn't arrived yet the
 * gesture degrades to a plain navigation on release.
 *
 * Renders nothing; it's a behaviour-only component.
 */
---

<script>
  import { navLinks } from "../data/site";

  const order = navLinks.map((link) => link.href);
  const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
  const indexOfPath = (path: string) =>
    order.findIndex((href) => normalize(href) === normalize(path));

  const mobile = window.matchMedia("(max-width: 720px) and (pointer: coarse)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  /** Horizontal travel before we take the gesture over from the scroller. */
  const ENGAGE_DISTANCE = 12;
  /** Fraction of the screen that counts as "committed". */
  const COMMIT_RATIO = 0.3;
  /** …or this much px/ms, so a short flick still turns the page. */
  const COMMIT_VELOCITY = 0.5;
  /**
   * Velocity is measured across this trailing window rather than the last two
   * move events: a single pair can be milliseconds apart, which makes the
   * computed speed explode and turns a slow, deliberate drag into a "flick".
   */
  const VELOCITY_WINDOW = 100;
  /** Ignore samples closer together than this when dividing by elapsed time. */
  const MIN_SAMPLE_GAP = 8;
  /** A finger that paused before lifting has no velocity, whatever it did before. */
  const STALE_SAMPLE = 120;
  const SETTLE_MS = 260;
  const EDGE_GUTTER = 28;

  type Page = { main: string; title: string };

  const pages = new Map<string, Promise<Page | null>>();
  const injectedStyles = new Set<string>();

  /**
   * Per-page scoped CSS is inlined into each document, so a neighbour's markup
   * would land here unstyled. Carry its <style>/<link> tags across too.
   */
  function adoptStyles(doc: Document) {
    doc.querySelectorAll("style").forEach((style) => {
      const css = style.textContent ?? "";
      if (!css || injectedStyles.has(css)) return;
      injectedStyles.add(css);
      const el = document.createElement("style");
      el.textContent = css;
      document.head.appendChild(el);
    });

    doc
      .querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')
      .forEach((link) => {
        const href = link.getAttribute("href");
        if (!href || document.querySelector(`link[href="${href}"]`)) return;
        const el = document.createElement("link");
        el.rel = "stylesheet";
        el.href = href;
        document.head.appendChild(el);
      });
  }

  function fetchPage(href: string): Promise<Page | null> {
    let pending = pages.get(href);
    if (pending) return pending;

    pending = fetch(href)
      .then((res) => (res.ok ? res.text() : Promise.reject(res.status)))
      .then((html) => {
        const doc = new DOMParser().parseFromString(html, "text/html");
        const main = doc.querySelector("main");
        if (!main) return null;
        adoptStyles(doc);
        return { main: main.innerHTML, title: doc.title };
      })
      .catch(() => null);

    pages.set(href, pending);
    return pending;
  }

  function neighbour(direction: 1 | -1): string | null {
    const current = indexOfPath(location.pathname);
    if (current === -1) return null;
    return order[current + direction] ?? null;
  }

  function prefetchNeighbours() {
    for (const direction of [1, -1] as const) {
      const href = neighbour(direction);
      if (href) fetchPage(href);
    }
  }

  // --- Gesture --------------------------------------------------------------

  let mainEl: HTMLElement | null = null;
  let panel: HTMLElement | null = null;

  let tracking = false;
  let engaged = false;
  let startX = 0;
  let startY = 0;
  let samples: { x: number; t: number }[] = [];
  let forward = true;
  let targetHref: string | null = null;
  let width = 0;

  function recordSample(x: number, t: number) {
    samples.push({ x, t });
    while (samples.length > 1 && t - samples[0].t > VELOCITY_WINDOW) {
      samples.shift();
    }
  }

  /** px/ms across the trailing window; 0 if the finger had already settled. */
  function velocityAt(endX: number, endT: number): number {
    const oldest = samples[0];
    const newest = samples[samples.length - 1];
    if (!oldest || !newest) return 0;
    if (endT - newest.t > STALE_SAMPLE) return 0;

    const elapsed = endT - oldest.t;
    if (elapsed < MIN_SAMPLE_GAP) return 0;
    return (endX - oldest.x) / elapsed;
  }

  function insideHorizontalScroller(target: EventTarget | null): boolean {
    let node = target instanceof Element ? target : null;
    while (node && node !== document.body) {
      const overflowX = getComputedStyle(node).overflowX;
      if (
        (overflowX === "auto" || overflowX === "scroll") &&
        node.scrollWidth > node.clientWidth
      ) {
        return true;
      }
      node = node.parentElement;
    }
    return false;
  }

  function menuIsOpen(): boolean {
    return Boolean(
      document.querySelector("[data-nav-links]")?.hasAttribute("data-open"),
    );
  }

  function setOffset(dx: number) {
    if (!mainEl) return;
    mainEl.style.transform = `translate3d(${dx}px, 0, 0)`;
    if (panel) {
      const base = forward ? width : -width;
      panel.style.transform = `translate3d(${base + dx}px, 0, 0)`;
    }
  }

  function setTransition(on: boolean) {
    const value = on ? `transform ${SETTLE_MS}ms cubic-bezier(0.32,0.72,0,1)` : "";
    if (mainEl) mainEl.style.transition = value;
    if (panel) panel.style.transition = value;
  }

  function teardown() {
    document.documentElement.classList.remove("is-swiping");
    if (mainEl) {
      mainEl.style.transform = "";
      mainEl.style.transition = "";
    }
    panel?.remove();
    panel = null;
    engaged = false;
    tracking = false;
  }

  function commit(page: Page, href: string) {
    if (!mainEl) return;

    mainEl.innerHTML = page.main;
    document.title = page.title;
    history.pushState({ swipe: true }, "", href);
    syncNav();
    window.scrollTo(0, 0);
    teardown();

    // Keyboard and screen-reader users land at the top of the new content.
    mainEl.setAttribute("tabindex", "-1");
    mainEl.focus({ preventScroll: true });

    announceSwap();
    prefetchNeighbours();
  }

  /**
   * Replacing <main> destroys whatever the page's own scripts were bound to,
   * and no document load follows to re-run them. Anything with behaviour inside
   * <main> (the hero carousel) listens for this to re-bind itself.
   */
  function announceSwap() {
    document.dispatchEvent(new CustomEvent("page:swapped"));
  }

  function syncNav() {
    const here = normalize(location.pathname);
    document
      .querySelectorAll<HTMLAnchorElement>("[data-nav-link]")
      .forEach((link) => {
        // `aria-current` is what the active styling keys off, so setting it
        // here is all the repaint needs — see Nav.astro.
        const active = normalize(link.getAttribute("href") ?? "") === here;
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
  }

  document.addEventListener(
    "touchstart",
    (event) => {
      tracking = false;
      engaged = false;
      if (!mobile.matches || event.touches.length !== 1 || menuIsOpen()) return;
      if (indexOfPath(location.pathname) === -1) return;

      const touch = event.touches[0];
      if (
        touch.clientX < EDGE_GUTTER ||
        touch.clientX > window.innerWidth - EDGE_GUTTER
      ) {
        return;
      }
      if (insideHorizontalScroller(event.target)) return;

      startX = touch.clientX;
      startY = touch.clientY;
      samples = [];
      recordSample(touch.clientX, event.timeStamp);
      tracking = true;
    },
    { passive: true },
  );

  document.addEventListener(
    "touchmove",
    (event) => {
      if (!tracking) return;

      const touch = event.touches[0];
      const dx = touch.clientX - startX;
      const dy = touch.clientY - startY;

      if (!engaged) {
        // Let a vertical scroll win outright.
        if (Math.abs(dy) > Math.abs(dx)) {
          tracking = false;
          return;
        }
        if (Math.abs(dx) < ENGAGE_DISTANCE) return;

        forward = dx < 0;
        targetHref = neighbour(forward ? 1 : -1);
        if (!targetHref) {
          tracking = false;
          return;
        }

        const ready = pages.get(targetHref);
        mainEl = document.querySelector("main");
        if (!ready || !mainEl) {
          // Neighbour isn't in hand yet — fall back to navigating on release.
          engaged = true;
          width = window.innerWidth;
          return;
        }

        width = window.innerWidth;
        engaged = true;
        document.documentElement.classList.add("is-swiping");

        panel = document.createElement("div");
        panel.className = "swipe-panel";
        panel.setAttribute("aria-hidden", "true");
        panel.style.transform = `translate3d(${forward ? width : -width}px, 0, 0)`;
        document.body.appendChild(panel);

        ready.then((page) => {
          if (panel && page) panel.innerHTML = page.main;
        });
      }

      if (engaged) {
        // We own this gesture now; stop the page scrolling under it.
        if (event.cancelable) event.preventDefault();

        recordSample(touch.clientX, event.timeStamp);

        // Resist dragging when there's nothing to reveal.
        setOffset(panel ? dx : dx * 0.25);
      }
    },
    { passive: false },
  );

  document.addEventListener("touchend", (event) => {
    if (!tracking || !engaged) {
      tracking = false;
      return;
    }
    tracking = false;

    const endX = event.changedTouches[0].clientX;
    const dx = endX - startX;
    const href = targetHref;
    const velocity = velocityAt(endX, event.timeStamp);

    // A flick only counts if it's still heading the way the drag opened —
    // reversing direction before lifting should cancel, not commit.
    const towardTarget = forward ? velocity < 0 : velocity > 0;
    const flicked =
      towardTarget &&
      Math.abs(velocity) > COMMIT_VELOCITY &&
      Math.abs(dx) > ENGAGE_DISTANCE;

    // No preview panel: nothing to animate, just go.
    if (!panel || !href) {
      teardown();
      if (href && (Math.abs(dx) > width * COMMIT_RATIO || flicked)) {
        location.assign(href);
      }
      return;
    }

    const shouldCommit = Math.abs(dx) / width > COMMIT_RATIO || flicked;

    const pending = pages.get(href);
    if (!pending) {
      teardown();
      return;
    }

    pending.then((page) => {
      if (shouldCommit && page) {
        if (reducedMotion.matches) {
          commit(page, href);
          return;
        }
        setTransition(true);
        setOffset(forward ? -width : width);
        window.setTimeout(() => commit(page, href), SETTLE_MS);
      } else {
        if (reducedMotion.matches) {
          teardown();
          return;
        }
        setTransition(true);
        setOffset(0);
        window.setTimeout(teardown, SETTLE_MS);
      }
    });
  });

  document.addEventListener("touchcancel", () => {
    if (engaged) teardown();
    tracking = false;
  });

  // Back/forward across entries we pushed ourselves stay in-document.
  window.addEventListener("popstate", () => {
    if (indexOfPath(location.pathname) === -1) return;
    fetchPage(location.pathname).then((page) => {
      const main = document.querySelector("main");
      if (!page || !main) {
        location.reload();
        return;
      }
      main.innerHTML = page.main;
      document.title = page.title;
      syncNav();
      announceSwap();
      prefetchNeighbours();
    });
  });

  if (typeof requestIdleCallback === "function") {
    requestIdleCallback(() => prefetchNeighbours());
  } else {
    window.setTimeout(prefetchNeighbours, 400);
  }
</script>
