---
import "../styles/global.css";
import { Font } from "astro:assets";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SwipeNavigation from "../components/SwipeNavigation.astro";
import { site } from "../data/site";
import {
  websiteNode,
  organizationNode,
  breadcrumbNode,
  type JsonLdNode,
} from "../data/schema";

interface Props {
  title: string;
  description?: string;
  /**
   * Extra schema.org nodes for this page. They're merged into one @graph
   * with the sitewide WebSite and Organization. A node whose `@id` matches
   * a sitewide one replaces it; the homepage uses this to give the
   * Organization its fuller LocalBusiness form.
   */
  jsonLd?: JsonLdNode | JsonLdNode[];
  /** Leave out the sitewide graph and breadcrumbs (the 404 page). */
  noJsonLd?: boolean;
  /**
   * Keep this page out of search results: emits `robots: noindex` and drops
   * the canonical and og:url, which would otherwise point at a URL (like
   * /404/) that doesn't exist as a real page.
   */
  noindex?: boolean;
  /**
   * Share image for this page. Defaults to the sitewide 1200x630 card in
   * public/og/. A root-relative path is resolved against `site`; pass a
   * JPEG at 1200x630 so the width, height and type below stay true.
   */
  ogImage?: { src: string; alt: string; width?: number; height?: number; type?: string };
}

const defaultOgImage = {
  src: "/og/default.jpg",
  alt: "ChickenBerry Hill Farm, Hartsville, Tennessee: the herd and flock grazing an open green pasture below a wooded hillside.",
  width: 1200,
  height: 630,
  type: "image/jpeg",
};

const {
  title,
  description = site.description,
  jsonLd,
  noJsonLd = false,
  noindex = false,
  ogImage,
} = Astro.props;
// A title that already names the farm is used as written (the keyword-rich
// titles on the main pages); anything else gets the brand appended.
const pageTitle = title.includes(site.shortName)
  ? title
  : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = { ...defaultOgImage, ...ogImage };
const ogImageUrl = new URL(og.src, Astro.site).toString();

const pageNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const overridden = new Set(pageNodes.map((node) => node["@id"]).filter(Boolean));
const breadcrumb = breadcrumbNode(Astro.url.pathname);
const graph = noJsonLd
  ? []
  : [
      ...[websiteNode, organizationNode].filter((node) => !overridden.has(node["@id"])),
      ...pageNodes,
      ...(breadcrumb ? [breadcrumb] : []),
    ];
// Escape "<" so no string value can close the <script> element early.
const jsonLdText = graph.length
  ? JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c")
  : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={og.type} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={og.alt} />

    {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}

    <!-- Both families are used above the fold (nav + hero), so both are
         preloaded. One variable file each. -->
    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-newsreader" preload />

    <!-- Google Analytics, deferred. The gtag() stub and config are queued
         right away, so nothing is lost: page_view (and any swipe page_views
         below) wait in dataLayer. gtag.js itself (~180 KB) is only fetched
         once the page is idle after load, or on the first interaction if that
         comes sooner, so it no longer competes with first render. -->
    <script is:inline define:vars={{ gaId: site.gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId);

      (function () {
        var loaded = false;
        var events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
        function load() {
          if (loaded) return;
          loaded = true;
          events.forEach(function (e) { removeEventListener(e, load, true); });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        }
        events.forEach(function (e) {
          addEventListener(e, load, { once: true, passive: true, capture: true });
        });
        function whenIdle() {
          if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 3000 });
          else setTimeout(load, 1500);
        }
        if (document.readyState === 'complete') whenIdle();
        else addEventListener('load', whenIdle, { once: true });
      })();
    </script>
  </head>
  <body class="bg-bg font-sans text-ink antialiased">
    <div class="min-h-screen">
      <Nav />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <SwipeNavigation />
    <!-- Swipes replace <main> without a new document, so the tag in <head>
         never sees them. gtag() is the queued stub from <head>, so these are
         delivered even if gtag.js hasn't loaded yet. -->
    <script>
      document.addEventListener("page:swapped", () => {
        const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
        if (typeof gtag !== "function") return;
        gtag("event", "page_view", {
          page_title: document.title,
          page_location: window.location.href,
        });
      });
    </script>
  </body>
</html>
