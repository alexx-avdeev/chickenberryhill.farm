---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Photo from "../components/Photo.astro";
import aboutLead from "../assets/about-lead.jpg";
import { values } from "../data/site";
---

<BaseLayout
  title="About"
  description="ChickenBerry Hill is a small, hands-on family farm outside Hartsville, Tennessee — goats, sheep, rabbits, quail, geese, and chickens raised on pasture."
>
  <!-- HEADER -->
  <section
    class="mx-auto max-w-copy px-[18px] pt-24 pb-14 text-center md:px-8"
  >
    <p
      class="mb-5 text-[13px] font-semibold tracking-[0.14em] text-green uppercase"
    >
      Our story
    </p>
    <h1
      class="mx-auto max-w-[16ch] font-display text-[clamp(40px,6vw,72px)] leading-[1.05] font-normal tracking-[-0.02em] text-ink"
    >
      A family, a hill, and a lot of animals.
    </h1>
  </section>

  <!-- LEAD IMAGE -->
  <section class="mx-auto mb-18 max-w-page px-[18px] md:px-8">
    <!-- 16/9, as the design renders it.
         The design's CSS also carries `max-height:520px`, but at its ~889px
         preview width 16/9 works out to 500px, so that cap never binds and was
         never seen. At our full 1056px shell it would clamp the frame to
         2.03:1 and crop far harder than the design ever showed, so it's left
         off deliberately — don't "restore" it.

         The master is pre-cropped to the exact visible band, so nothing is
         downloaded that the frame then throws away, and no object-position is
         needed. The framing was derived from `about-lead-uncropped.jpg`
         (2000x1414, 40px black bar top and bottom): a 16/9 cover crop hides
         289px of height, so the band starts at row 40 — where the bar ends —
         and runs 1125px, which is exactly 16/9. Taking it all off the bottom
         is what keeps the head in the second panel intact; centring instead
         would cost 104px of headroom and clip it. Re-crop from the uncropped
         file if the framing ever needs to change. -->
    <Photo
      image={aboutLead}
      alt="Four moments from the farm: a child holding a large buff chicken; a man kneeling to bottle-feed a black-and-white lamb; a young woman cheek to cheek with a grey goat; and a child in a hooded sweatshirt cradling a cream-coloured goat kid."
      label="Drop a photo of your family / farm"
      aspect="16 / 9"
      eager
      maxWidth={1440}
    />
  </section>

  <!-- STORY BODY -->
  <section
    class="mx-auto max-w-narrow px-[18px] pb-10 text-[18px] leading-[1.7] text-ink-muted md:px-8"
  >
    <p
      class="mb-8 font-display text-[clamp(21px,2.4vw,26px)] leading-[1.5] text-ink-body"
    >
      It started with a few chickens and a promise to ourselves: to raise food
      we'd be proud to feed our own family.
    </p>
    <p class="mb-[22px]">
      Tucked into the rolling countryside outside Hartsville, Tennessee,
      ChickenBerry Hill is a small, hands-on farm. What began as a backyard
      flock has grown, season by season, into a working homestead — goats and
      sheep grazing the pasture, rabbits and quail in tidy hutches, geese
      keeping watch, and chickens doing what chickens do best.
    </p>
    <p class="mb-[22px]">
      We do things the slow way on purpose. Our animals live on open ground and
      clean air, with room to be themselves. We know them by name and by
      temperament. That care is the whole point — and you can taste it in
      everything we sell.
    </p>
    <p>
      When you buy from us, you're not buying from a label. You're buying from
      neighbors who did the chores this morning and will do them again tonight.
    </p>
  </section>

  <!-- VALUES -->
  <section class="mt-16 border-y border-line bg-tint">
    <div
      class="mx-auto grid max-w-page grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-10 px-[18px] py-20 md:px-8"
    >
      {
        values.map((value) => (
          <div>
            <div
              class="mb-[18px] flex size-11 items-center justify-center rounded-xl border border-line bg-bg font-display text-[22px] text-green"
              aria-hidden="true"
            >
              <span>{value.num}</span>
            </div>
            <h2 class="mb-2.5 font-display text-[22px] font-medium text-ink">
              {value.title}
            </h2>
            <p class="text-[16px] leading-[1.6] text-ink-soft">{value.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-copy px-[18px] py-22 text-center md:px-8">
    <h2
      class="mx-auto max-w-[16ch] font-display text-[clamp(28px,4vw,44px)] leading-[1.15] font-normal tracking-[-0.015em] text-ink"
    >
      Want to taste the difference?
    </h2>
    <div class="mt-[30px] flex flex-wrap justify-center gap-[14px]">
      <Button href="/products/">Shop the farm</Button>
      <Button href="/contact/" variant="outline">Say hello →</Button>
    </div>
  </section>
</BaseLayout>
