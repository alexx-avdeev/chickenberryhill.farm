---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import InstagramIcon from "../components/InstagramIcon.astro";
import { site, products, orderMailto, reserveMailto, mailto } from "../data/site";

const helloMailto = mailto("Hello from the ChickenBerry Hill website");

// Bottom margin is left to each use — "Follow along" sits slightly further off
// its link than the other two do off their paragraphs. Stacking two `mb-*`
// utilities here would leave the winner up to Tailwind's output order.
const asideLabel =
  "text-[13px] font-semibold tracking-[0.1em] text-green uppercase";
---

<BaseLayout
  title="Contact"
  description="Place an order or say hello to ChickenBerry Hill Farm in Hartsville, Tennessee. On-farm pickup by appointment."
>
  <div
    class="mx-auto grid max-w-note grid-cols-1 gap-16 px-[18px] py-24 md:px-8"
  >
    <!-- HEADER -->
    <section class="text-center">
      <p
        class="mb-5 text-[13px] font-semibold tracking-[0.14em] text-green uppercase"
      >
        Get in touch
      </p>
      <h1
        class="mx-auto max-w-[16ch] font-display text-[clamp(40px,6vw,72px)] leading-[1.05] font-normal tracking-[-0.02em] text-ink"
      >
        Place an order or say hello
      </h1>
      <p
        class="mx-auto mt-6 max-w-[48ch] text-[18px] leading-[1.55] text-ink-soft"
      >
        Tell us what you're after and we'll get right back to you with
        availability and pickup details.
      </p>
    </section>

    <div
      class="grid grid-cols-[1.4fr_1fr] items-start gap-14 max-md:grid-cols-1 max-md:gap-10"
    >
      <!-- EMAIL CARD -->
      <section
        class="rounded-3xl border border-green-border bg-green-tint p-10 max-md:px-6 max-md:py-8"
      >
        <h2 class="font-display text-[26px] font-medium text-ink">
          Send us an email
        </h2>
        <p class="mt-3 text-[16px] leading-[1.6] text-ink-quiet">
          The fastest way to reach the farm. Let us know what you'd like, how
          much, and roughly when you need it — we'll reply with availability and
          a pickup time.
        </p>

        <Button href={orderMailto} class="mt-7">Email us about an order</Button>

        <p class="mt-[18px] text-[15px] text-ink-soft">
          or write to <a href={helloMailto}>{site.email}</a>
        </p>

        <div class="mt-8 border-t border-green-border pt-7">
          <p
            class="mb-3 text-[13px] font-semibold tracking-[0.1em] text-green uppercase"
          >
            Reserve something specific
          </p>
          <ul class="flex flex-col gap-2.5">
            {
              products.map((product) => (
                <li>
                  <a
                    href={reserveMailto(product.name)}
                    class="text-[15px] font-semibold"
                  >
                    {product.name} →
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- SIDE INFO -->
      <aside class="flex flex-col gap-8">
        <div>
          <h2 class:list={[asideLabel, "mb-1.5"]}>Find us</h2>
          <p class="text-[17px] leading-[1.5] text-ink-body">
            {site.name}<br />{site.location}
          </p>
        </div>
        <div>
          <h2 class:list={[asideLabel, "mb-1.5"]}>Pickup</h2>
          <p class="text-[16px] leading-[1.55] text-ink-mid">
            On-farm pickup by appointment. We'll coordinate a time when you
            order.
          </p>
        </div>
        <div>
          <h2 class:list={[asideLabel, "mb-2.5"]}>Follow along</h2>
          <a
            href={site.instagram}
            class="inline-flex items-center gap-[9px] text-[16px] font-semibold"
            rel="me noopener noreferrer"
            target="_blank"
          >
            <InstagramIcon size={20} />
            {site.instagramHandle}
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
