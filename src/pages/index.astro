---
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import { site, animals, products } from "../data/site";
---

<BaseLayout title={site.name}>
  <!-- HERO -->
  <section class="shell hero">
    <p class="eyebrow">{site.location}</p>
    <h1 class="display-xl measure-14">
      Raised with care, right here on the hill.
    </h1>
    <p class="lede">
      A small family farm raising goats, sheep, rabbits, geese, chicken, and
      quail — and selling honest chicken, lamb, and quail eggs to our neighbors.
    </p>
    <div class="btn-row">
      <a href="/products/" class="btn btn--primary">Shop the farm</a>
      <a href="/about/" class="btn btn--outline">Our story →</a>
    </div>
  </section>

  <!-- HERO IMAGE -->
  <section class="shell hero-image">
    <Photo
      label="Drop a wide farm / pasture photo"
      height="clamp(320px, 52vw, 560px)"
      eager
    />
  </section>

  <!-- STORY TEASER -->
  <section class="shell shell--prose story center">
    <h2 class="display-md">We know every animal by name.</h2>
    <p class="story__body">
      ChickenBerry Hill started as a family dream and grew into a working farm
      on the rolling ground outside Hartsville. We raise our animals slowly and
      kindly, on pasture and open air — the way food is supposed to be made.
    </p>
    <a href="/about/" class="text-link story__link">Read our story →</a>
  </section>

  <!-- WHAT WE RAISE -->
  <section class="band">
    <div class="shell raise">
      <div class="center raise__head">
        <p class="eyebrow">The herd &amp; flock</p>
        <h2 class="display-md">What we raise</h2>
      </div>
      <ul class="raise__grid">
        {
          animals.map((animal) => (
            <li class="raise__item">
              <Photo
                src={animal.image}
                alt={animal.name}
                label={animal.name}
                aspect="1 / 1"
                radius="var(--radius-md)"
              />
              <p class="raise__name">{animal.name}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- PRODUCTS HIGHLIGHT -->
  <section class="shell shop">
    <div class="shop__head">
      <div>
        <p class="eyebrow">From our farm</p>
        <h2 class="display-md">Fresh &amp; for sale</h2>
      </div>
      <a href="/products/" class="text-link">See all products →</a>
    </div>
    <ul class="shop__grid">
      {
        products.map((product) => (
          <li>
            <a href="/products/" class="shop__card">
              <Photo
                src={product.image}
                alt={product.name}
                label={product.name}
                aspect="4 / 3"
                radius="0"
              />
              <div class="shop__body">
                <h3 class="display-sm">{product.name}</h3>
                <p class="shop__desc">{product.teaser}</p>
                <p class="shop__price">{product.teaserPrice}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- CTA BAND -->
  <section class="shell cta-wrap">
    <div class="cta">
      <h2 class="cta__title measure-18">Come meet your farmers.</h2>
      <p class="cta__body">
        Place an order, ask a question, or just say hello. We'd love to hear from
        you.
      </p>
      <a href="/contact/" class="btn btn--light cta__btn">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 96px 72px;
    text-align: center;
  }

  .hero-image {
    margin-bottom: 40px;
  }

  /* Story teaser */
  .story {
    padding-block: 80px;
  }

  .story__body {
    margin: 24px auto 0;
    max-width: 56ch;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .story__link {
    display: inline-block;
    margin-top: 26px;
  }

  /* What we raise */
  .raise {
    padding-block: 80px;
  }

  .raise__head {
    margin-bottom: 48px;
  }

  /* Explicit column counts rather than auto-fit: with six animals, auto-fit
     leaves a single orphan tile on its own row at desktop widths. */
  .raise__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
  }

  @media (max-width: 900px) {
    .raise__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 480px) {
    .raise__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .raise__item {
    text-align: center;
  }

  .raise__name {
    margin: 14px 0 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
  }

  /* Products highlight */
  .shop {
    padding-block: 88px;
  }

  .shop__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 44px;
  }

  .shop__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .shop__card {
    display: block;
    height: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--bg);
    transition: border-color 0.15s ease;
  }

  .shop__card:hover {
    border-color: var(--border-hover);
  }

  .shop__body {
    padding: 22px 24px 26px;
  }

  .shop__desc {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .shop__price {
    margin: 16px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--berry);
  }

  /* CTA band */
  .cta-wrap {
    margin-bottom: 88px;
  }

  .cta {
    background: var(--surface-dark);
    border-radius: var(--radius-xl);
    padding: clamp(48px, 7vw, 88px) 32px;
    text-align: center;
  }

  .cta__title {
    margin: 0 auto;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 4.5vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink-on-dark);
  }

  .cta__body {
    margin: 20px auto 0;
    max-width: 46ch;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-on-dark-soft);
  }

  .cta__btn {
    margin-top: 32px;
  }
</style>
