---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Photo from "../components/Photo.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import { site, animals, products } from "../data/site";

// Matched to `animals` by filename, same idea as the hero carousel. A missing
// file falls through to the named placeholder rather than failing the build.
const animalPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/home/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const animalByFile = new Map(
  Object.entries(animalPhotos).map(([filePath, mod]) => [
    filePath.split("/").pop() ?? filePath,
    mod.default,
  ]),
);

/**
 * What the animal tiles actually render at. A full-bleed `sizes` would make
 * the browser download a hero-sized file for a square of about 160px.
 *
 * 2 columns at ≤480px (18px page padding, one 20px gap),
 * 3 columns at ≤900px (18px padding up to 720px, 32px after; two gaps),
 * 6 columns above that, inside the 1120px shell (32px padding, five gaps).
 *
 * The biggest tile is about 265px CSS, so `maxWidth` 640 covers a 2× screen
 * and a 3× phone. Wider variants would be downloaded and then scaled away.
 */
const animalSizes =
  "(max-width: 480px) calc((100vw - 56px) / 2), (max-width: 720px) calc((100vw - 76px) / 3), (max-width: 900px) calc((100vw - 104px) / 3), calc((min(100vw, 1120px) - 164px) / 6)";

const productPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/products/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const productByFile = new Map(
  Object.entries(productPhotos).map(([filePath, mod]) => [
    filePath.split("/").pop() ?? filePath,
    mod.default,
  ]),
);

/**
 * Home product cards: one column up to 720px, two after that. The widest
 * card is the one-column layout at 720px (~684px), so `maxWidth` 1440 is a
 * 2× image there and more than enough everywhere else.
 */
const productSizes =
  "(max-width: 720px) calc(100vw - 36px), calc((min(100vw, 1120px) - 88px) / 2)";
---

<BaseLayout title={site.name}>
  <!-- HERO -->
  <section class="mx-auto max-w-page px-[18px] pt-24 pb-18 text-center md:px-8">
    <p
      class="mb-5 text-[13px] font-semibold tracking-[0.14em] text-green uppercase"
    >
      {site.location}
    </p>
    <h1
      class="mx-auto max-w-[14ch] font-display text-[clamp(44px,7vw,88px)] leading-[1.02] font-normal tracking-[-0.02em] text-ink"
    >
      Raised with care, right here on the hill.
    </h1>
    <p
      class="mx-auto mt-7 max-w-[52ch] text-[clamp(17px,2vw,21px)] leading-[1.55] text-ink-soft"
    >
      A small family farm raising goats, sheep, rabbits, geese, chicken, and
      quail — and selling honest chicken, lamb, rabbit, and quail eggs to our neighbors.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-[14px]">
      <Button href="/products/">Shop the farm</Button>
      <Button href="/about/" variant="outline">Our story →</Button>
    </div>
  </section>

  <!-- HERO CAROUSEL -->
  <section class="mx-auto mb-10 max-w-page px-[18px] md:px-8">
    <HeroCarousel />
  </section>

  <!-- STORY TEASER -->
  <section class="mx-auto max-w-copy px-[18px] py-20 text-center md:px-8">
    <h2
      class="mx-auto font-display text-[clamp(28px,4vw,44px)] leading-[1.15] font-normal tracking-[-0.015em] text-ink"
    >
      We know every animal by name.
    </h2>
    <p class="mx-auto mt-6 max-w-[56ch] text-[18px] leading-[1.6] text-ink-soft">
      ChickenBerry Hill started as a family dream and grew into a working farm
      on the rolling ground outside Hartsville. We raise our animals slowly and
      kindly, on pasture and open air — the way food is supposed to be made.
    </p>
    <a href="/about/" class="mt-[26px] inline-block text-[15px] font-semibold"
      >Read our story →</a
    >
  </section>

  <!-- WHAT WE RAISE -->
  <section class="border-y border-line bg-tint">
    <div class="mx-auto max-w-page px-[18px] py-20 md:px-8">
      <div class="mb-12 text-center">
        <p
          class="mb-5 text-[13px] font-semibold tracking-[0.14em] text-green uppercase"
        >
          The herd &amp; flock
        </p>
        <h2
          class="mx-auto font-display text-[clamp(28px,4vw,44px)] leading-[1.15] font-normal tracking-[-0.015em] text-ink"
        >
          What we raise
        </h2>
      </div>
      {/* Explicit column counts rather than auto-fit: with six animals,
          auto-fit leaves a single orphan tile on its own row at desktop. */}
      <ul class="grid grid-cols-6 gap-5 max-lg:grid-cols-3 max-sm:grid-cols-2">
        {
          animals.map((animal) => (
            <li class="text-center">
              <Photo
                image={animalByFile.get(animal.file) ?? null}
                alt={animal.alt}
                label={animal.name}
                aspect="1 / 1"
                radius="var(--radius-tile)"
                maxWidth={640}
                sizes={animalSizes}
              />
              <p class="mt-3.5 text-[16px] font-semibold text-ink">
                {animal.name}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- PRODUCTS HIGHLIGHT -->
  <section class="mx-auto max-w-page px-[18px] py-22 md:px-8">
    <div class="mb-11 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p
          class="mb-5 text-[13px] font-semibold tracking-[0.14em] text-green uppercase"
        >
          From our farm
        </p>
        <h2
          class="font-display text-[clamp(28px,4vw,44px)] leading-[1.15] font-normal tracking-[-0.015em] text-ink"
        >
          Fresh &amp; for sale
        </h2>
      </div>
      <a href="/products/" class="text-[15px] font-semibold"
        >See all products →</a
      >
    </div>
    {/* Two columns, not auto-fit: four products would leave a single
        orphan on the last row. */}
    <ul class="grid grid-cols-2 gap-6 max-md:grid-cols-1">
      {
        products.map((product) => (
          <li>
            <a
              href="/products/"
              class="block h-full overflow-hidden rounded-panel border border-line bg-bg transition-colors hover:border-line-hover"
            >
              <Photo
                image={productByFile.get(product.file) ?? null}
                alt={product.alt}
                label={product.name}
                aspect="4 / 3"
                radius="0"
                maxWidth={1440}
                sizes={productSizes}
              />
              <div class="px-6 pt-[22px] pb-[26px]">
                <h3 class="font-display text-[22px] font-medium text-ink">
                  {product.name}
                </h3>
                <p class="mt-2 text-[15px] leading-[1.5] text-ink-soft">
                  {product.teaser}
                </p>
                <p class="mt-4 text-[14px] font-semibold text-berry">
                  {product.teaserPrice}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- CTA BAND -->
  <section class="mx-auto mb-22 max-w-page px-[18px] md:px-8">
    <div
      class="rounded-panel bg-dark px-8 py-[clamp(48px,7vw,88px)] text-center"
    >
      <h2
        class="mx-auto max-w-[18ch] font-display text-[clamp(28px,4.5vw,48px)] leading-[1.1] font-normal tracking-[-0.015em] text-ink-on-dark"
      >
        Come meet your farmers.
      </h2>
      <p
        class="mx-auto mt-5 max-w-[46ch] text-[18px] leading-[1.55] text-ink-on-dark-soft"
      >
        Place an order, ask a question, or just say hello. We'd love to hear from
        you.
      </p>
      <Button href="/contact/" variant="light" class="mt-8">Get in touch</Button>
    </div>
  </section>
</BaseLayout>
