---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Photo from "../components/Photo.astro";
import { products, orderMailto, reserveMailto } from "../data/site";

// Looked up rather than interpolated: Tailwind scans source text for whole
// class names, so a built-up `text-${tone}` would never be generated.
const tagTone = {
  green: "text-green",
  berry: "text-berry",
};

// Matched to `products` by filename. A missing file falls through to the
// named placeholder rather than failing the build.
const productPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/products/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const productByFile = new Map(
  Object.entries(productPhotos).map(([filePath, mod]) => [
    filePath.split("/").pop() ?? filePath,
    mod.default,
  ]),
);

/**
 * One column up to 720px, two after that, inside the 1120px shell (32px
 * padding, one 28px gap). Same width cap as the home cards.
 *
 * The first two cards are on screen when the page opens. A lazy second
 * card waits until after layout, so it appears after the rest of the page.
 */
const productSizes =
  "(max-width: 720px) calc(100vw - 36px), calc((min(100vw, 1120px) - 92px) / 2)";
---

<BaseLayout
  title="Products"
  description="Pasture-raised chicken, grass-fed lamb, rabbit, and fresh quail eggs from ChickenBerry Hill Farm in Hartsville, Tennessee."
>
  <!-- HEADER -->
  <section
    class="mx-auto max-w-copy px-[18px] pt-24 pb-14 text-center md:px-8"
  >
    <p
      class="mb-5 text-[13px] font-semibold tracking-[0.14em] text-green uppercase"
    >
      The farm stand
    </p>
    <h1
      class="mx-auto max-w-[14ch] font-display text-[clamp(40px,6vw,72px)] leading-[1.05] font-normal tracking-[-0.02em] text-ink"
    >
      What's for sale
    </h1>
    <p
      class="mx-auto mt-[26px] max-w-[50ch] text-[19px] leading-[1.55] text-ink-soft"
    >
      Everything here comes from our own animals. Availability shifts with the
      seasons — reserve what you'd like and we'll be in touch.
    </p>
  </section>

  <!-- PRODUCTS -->
  <section class="mx-auto max-w-page px-[18px] pt-4 pb-10 md:px-8">
    {/* Two columns, not auto-fit: four products would leave a single
        orphan on the last row. */}
    <ul class="grid grid-cols-2 gap-7 max-md:grid-cols-1">
      {
        products.map((product, i) => (
          <li class="flex flex-col overflow-hidden rounded-card border border-line bg-bg">
            <Photo
              image={productByFile.get(product.file) ?? null}
              alt={product.alt}
              label={product.name}
              aspect="4 / 3"
              radius="0"
              maxWidth={1440}
              sizes={productSizes}
              eager={i < 2}
              fetchPriority={i === 0 ? "high" : "auto"}
            >
              <span
                class:list={[
                  "absolute top-3.5 left-3.5 rounded-full bg-bg/92 px-3 py-1.5 text-[12px] font-bold tracking-[0.04em] uppercase backdrop-blur-[6px]",
                  tagTone[product.tagTone],
                ]}
              >
                {product.tag}
              </span>
            </Photo>
            <div class="flex flex-1 flex-col px-[26px] pt-[26px] pb-7">
              <h2 class="font-display text-[26px] font-medium text-ink">
                {product.name}
              </h2>
              <p class="mt-2.5 flex-1 text-[16px] leading-[1.6] text-ink-soft">
                {product.description}
              </p>
              <div class="mt-[22px] flex items-center justify-between gap-4">
                <span class="text-[15px] font-semibold text-ink-body">
                  {product.price}
                </span>
                <Button href={reserveMailto(product.name)} small>
                  Reserve
                </Button>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- NOTE -->
  <section class="mx-auto max-w-copy px-[18px] pt-14 pb-10 md:px-8">
    <div
      class="rounded-tile border border-dashed border-line-dashed bg-tint px-9 py-8 text-center"
    >
      <p class="text-[16px] leading-[1.6] text-ink-quiet">
        Not sure what's in stock right now? Seasonal items like chicken, lamb,
        and rabbit are raised in batches. Send us a note and we'll tell you
        exactly what's available and when.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-copy px-[18px] pt-10 pb-24 text-center md:px-8">
    <Button href={orderMailto} variant="dark">Place an order</Button>
  </section>
</BaseLayout>
