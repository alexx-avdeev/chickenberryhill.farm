{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chickenberryhill-farm",
  "compatibility_date": "2026-08-06",

  // No "main" entry: this is an assets-only Worker. Cloudflare serves the
  // static build directly, with no Worker script in front of it.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
